---
import { coverStyle } from '../lib/cover';
interface Props { href?: string; title: string; description: string; tags?: string[]; badge?: string; delay?: number; cover?: string; }
const { href, title, description, tags = [], badge, delay = 0, cover } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<div class="reveal h-full" style={`--d:${delay}ms`}>
  <Tag href={href} class="tilt glass group flex h-full flex-col">
    <div class="relative h-40 overflow-hidden" style={cover ? undefined : coverStyle(title)}>
      {cover ? (
        <img src={cover} alt={title} loading="lazy" class="h-full w-full object-cover object-top transition duration-500 group-hover:scale-105" />
      ) : (
        <>
          <div class="absolute -right-6 -top-6 h-28 w-28 rounded-full bg-white/20"></div>
          <div class="absolute -bottom-10 left-6 h-24 w-24 rounded-full bg-white/15"></div>
          <span class="absolute bottom-3 left-4 select-none font-mono text-5xl font-bold text-white/85">{title.slice(0, 1)}</span>
        </>
      )}
      {badge && <span class="absolute right-3 top-3 rounded-full bg-black/30 px-2.5 py-0.5 text-xs text-white backdrop-blur">{badge}</span>}
    </div>
    <div class="relative flex flex-1 flex-col p-5">
      <h3 class="font-bold leading-snug transition-colors group-hover:text-[var(--violet)]">{title}</h3>
      <p class="mt-2 line-clamp-4 flex-1 text-sm leading-relaxed" style="color:var(--muted)">{description}</p>
      <div class="mt-4 flex flex-wrap gap-1.5">{tags.slice(0, 5).map((t, i) => <span class:list={['chip', i % 2 && 'chip-cyan']}>{t}</span>)}</div>
    </div>
  </Tag>
</div>
