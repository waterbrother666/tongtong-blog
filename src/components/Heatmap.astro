---
// 贡献热力图:一年一张,一格一天,有更新的格子点亮
interface Item { date: Date; title: string; href: string }
interface Props { items: Item[] }
const { items } = Astro.props;
const DAY = 86400000;
const key = (d: Date) => d.toISOString().slice(0, 10);
const byDay = new Map<string, Item[]>();
for (const it of items) byDay.set(key(it.date), [...(byDay.get(key(it.date)) ?? []), it]);
const years = [...new Set(items.map((i) => i.date.getUTCFullYear()))].sort((a, b) => b - a);

function build(year: number) {
  const start = Date.UTC(year, 0, 1), end = Date.UTC(year, 11, 31);
  const offset = (new Date(start).getUTCDay() + 6) % 7; // 周一在最上面
  const cells: { k: string; col: number; row: number; list: Item[] }[] = [];
  const months: { m: number; col: number }[] = [];
  const monthCount = Array(12).fill(0);
  for (let t = start, i = 0; t <= end; t += DAY, i++) {
    const d = new Date(t);
    const list = byDay.get(key(d)) ?? [];
    const col = Math.floor((i + offset) / 7) + 1;
    if (d.getUTCDate() === 1) months.push({ m: d.getUTCMonth(), col });
    monthCount[d.getUTCMonth()] += list.length;
    cells.push({ k: key(d), col, row: ((i + offset) % 7) + 1, list });
  }
  return { year, cells, months, monthCount, cols: cells[cells.length - 1].col, total: monthCount.reduce((a, b) => a + b, 0) };
}
const charts = years.map(build);
---
{charts.map((c) => (
  <section class="mb-6 last:mb-0">
    <div class="mb-3 flex items-baseline justify-between gap-3">
      <h3 class="text-sm font-semibold">{c.year} 年的更新</h3>
      <span class="text-xs" style="color:var(--muted)">{c.total} 次更新(文章和教程章节) · 悬浮看标题,点击打开</span>
    </div>
    <div class="overflow-x-auto pb-1">
      <div class="heatmap" style={`--cols:${c.cols}`}>
        <div class="hm-months">
          {c.months.map(({ m, col }) => <span style={`grid-column:${col} / span 4`}>{m + 1}月{c.monthCount[m] > 0 && <b>{c.monthCount[m]}</b>}</span>)}
        </div>
        <div class="hm-grid">
          {c.cells.map((d) => d.list.length ? (
            <a href={d.list[0].href} class="hm-cell" data-level={Math.min(3, d.list.length)} data-date={d.k} data-tip={d.list.map((i) => i.title).join('\n')} aria-label={`${d.k}:${d.list.map((i) => i.title).join('、')}`} style={`grid-column:${d.col};grid-row:${d.row};--c:${d.col}`}></a>
          ) : (
            <i class="hm-cell" style={`grid-column:${d.col};grid-row:${d.row};--c:${d.col}`}></i>
          ))}
        </div>
      </div>
    </div>
    <div class="mt-3 flex items-center justify-end gap-1.5 text-xs" style="color:var(--muted)">
      <span>少</span>
      <i class="hm-cell w-3"></i><i class="hm-cell w-3" data-level="1"></i><i class="hm-cell w-3" data-level="2"></i><i class="hm-cell w-3" data-level="3"></i>
      <span>多</span>
    </div>
  </section>
))}
