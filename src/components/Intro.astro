---
// 入场:粒子拼成的名字。鼠标像风一样吹散粒子,离开后粒子回到名字上;点击名字进入主页。
// 是否显示由 Base.astro 头部的内联脚本决定(每次打开浏览器只出现一次)。
import { SITE } from '../config';
---
<div id="intro" data-name={SITE.author} role="button" tabindex="0" aria-label={`${SITE.author},点击名字进入主页`}>
  <div class="intro-bg"></div>
  <canvas></canvas>
</div>

<style is:global>
  #intro { display: none; position: fixed; inset: 0; z-index: 100; outline: none; touch-action: none; user-select: none; -webkit-user-select: none; }
  .intro-on #intro { display: block; }
  .intro-on body { overflow: hidden; }
  /* 主页大标题的入场动画等进入之后再播 */
  .intro-on .hero-char, .intro-on .hero-sub { animation-play-state: paused; }
  #intro .intro-bg {
    position: absolute; inset: 0; transition: opacity 0.65s ease;
    background:
      radial-gradient(70rem 34rem at 78% -6%, color-mix(in srgb, var(--violet) 34%, transparent), transparent 70%),
      radial-gradient(60rem 30rem at 8% 2%, color-mix(in srgb, var(--cyan) 26%, transparent), transparent 70%),
      var(--bg);
  }
  #intro canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  #intro.leaving { pointer-events: none; }
  #intro.leaving .intro-bg { opacity: 0; }
</style>

<script>
  type P = { x: number; y: number; vx: number; vy: number; hx: number; hy: number; t: number; c: string; s: number };

  function start(root: HTMLElement) {
    if (root.dataset.on) return;
    root.dataset.on = '1';
    const canvas = root.querySelector('canvas')!;
    const ctx = canvas.getContext('2d')!;
    const name = root.dataset.name || 'tongtong';
    const css = getComputedStyle(document.documentElement);
    const dark = document.documentElement.classList.contains('dark');
    const colA = css.getPropertyValue('--violet').trim() || '#a994ff';
    const colB = css.getPropertyValue('--cyan').trim() || '#6beaff';

    let W = 0, H = 0, dpr = 1, parts: P[] = [];
    let box = { x0: 0, y0: 0, x1: 0, y1: 0 };
    let leaving = 0; // 开始离场的时间戳
    let raf = 0;

    // 两个主题色之间取色
    const mixer = document.createElement('canvas').getContext('2d')!;
    const grad = (() => {
      mixer.canvas.width = 64; mixer.canvas.height = 1;
      const g = mixer.createLinearGradient(0, 0, 64, 0);
      g.addColorStop(0, colA); g.addColorStop(1, colB);
      mixer.fillStyle = g; mixer.fillRect(0, 0, 64, 1);
      const d = mixer.getImageData(0, 0, 64, 1).data;
      return (k: number) => { const i = Math.min(63, Math.max(0, Math.round(k * 63))) * 4; return `rgb(${d[i]},${d[i + 1]},${d[i + 2]})`; };
    })();

    function build() {
      dpr = Math.min(2, devicePixelRatio || 1);
      W = innerWidth; H = innerHeight;
      if (!W || !H) return; // 窗口还没有尺寸,等 resize 再来
      canvas.width = W * dpr; canvas.height = H * dpr;
      // 先把名字画到离屏画布上,再按网格取样成粒子
      const off = document.createElement('canvas');
      off.width = W; off.height = H;
      const o = off.getContext('2d', { willReadFrequently: true })!;
      const size = Math.min(W * 0.14, H * 0.3, 210);
      o.font = `800 ${size}px ui-rounded, "SF Pro Rounded", system-ui, -apple-system, "PingFang SC", sans-serif`;
      o.textAlign = 'center'; o.textBaseline = 'middle';
      o.fillText(name, W / 2, H / 2);
      const m = o.measureText(name);
      const pad = size * 0.25;
      box = { x0: W / 2 - m.width / 2 - pad, x1: W / 2 + m.width / 2 + pad, y0: H / 2 - size * 0.6 - pad, y1: H / 2 + size * 0.6 + pad };
      const target = W < 640 ? 1500 : 3600;
      const data = o.getImageData(0, 0, W, H).data;
      let gap = 3;
      const sample = (g: number) => { const pts: [number, number][] = []; for (let y = 0; y < H; y += g) for (let x = 0; x < W; x += g) if (data[(y * W + x) * 4 + 3] > 128) pts.push([x, y]); return pts; };
      let pts = sample(gap);
      while (pts.length > target && gap < 12) pts = sample(++gap);
      const old = parts;
      parts = pts.map(([hx, hy], i) => {
        const prev = old[i];
        // 第一次:从屏幕四周飘进来
        const a = Math.random() * Math.PI * 2, r = Math.max(W, H) * (0.55 + Math.random() * 0.5);
        return {
          x: prev ? prev.x : W / 2 + Math.cos(a) * r, y: prev ? prev.y : H / 2 + Math.sin(a) * r,
          vx: 0, vy: 0, hx, hy, t: prev ? prev.t : 1,
          c: grad((hx - (W / 2 - m.width / 2)) / Math.max(1, m.width)),
          s: gap * (0.58 + Math.random() * 0.22),
        };
      });
    }

    // 鼠标:位置和平滑后的速度(风向)
    const mouse = { x: -9999, y: -9999, vx: 0, vy: 0, on: false };
    const move = (e: PointerEvent) => {
      if (mouse.on) { mouse.vx += (e.clientX - mouse.x - mouse.vx) * 0.5; mouse.vy += (e.clientY - mouse.y - mouse.vy) * 0.5; }
      mouse.x = e.clientX; mouse.y = e.clientY; mouse.on = true;
      const inBox = e.clientX > box.x0 && e.clientX < box.x1 && e.clientY > box.y0 && e.clientY < box.y1;
      root.style.cursor = inBox ? 'pointer' : 'default';
    };
    const out = () => { mouse.on = false; };

    // 物理按固定步长走(每秒 60 步),高刷新率屏幕上速度也一样
    function step() {
      const R = W < 640 ? 80 : 120, R2 = R * R;
      const speed = Math.hypot(mouse.vx, mouse.vy);
      for (const p of parts) {
        if (!leaving) {
          const dx = p.x - mouse.x, dy = p.y - mouse.y, d2 = dx * dx + dy * dy;
          if (mouse.on && d2 < R2) {
            const d = Math.sqrt(d2) || 1, f = 1 - d / R;
            // 风:顺着鼠标移动的方向吹,带一点旋涡,再轻轻推开
            p.vx += mouse.vx * f * 0.22 + (-dy / d) * f * speed * 0.05 + (dx / d) * f * 0.9;
            p.vy += mouse.vy * f * 0.22 + (dx / d) * f * speed * 0.05 + (dy / d) * f * 0.9;
            p.t = Math.min(1, p.t + f * 0.6);
          }
          // 被吹过的粒子先飘一会儿,再用弹簧拉回名字上
          const k = 0.006 + (1 - p.t) * 0.05;
          p.vx += (p.hx - p.x) * k; p.vy += (p.hy - p.y) * k;
          p.vx *= 0.9; p.vy *= 0.9;
          p.t *= 0.975;
        } else { p.vx *= 0.985; p.vy *= 0.985; }
        p.x += p.vx; p.y += p.vy;
      }
      mouse.vx *= 0.85; mouse.vy *= 0.85;
    }
    let last = 0, acc = 0;
    function frame(now: number) {
      raf = requestAnimationFrame(frame);
      acc += Math.min(100, last ? now - last : 16.7);
      last = now;
      for (let i = 0; acc >= 16.6 && i < 6; i++) { step(); acc -= 16.6; }
      if (acc > 100) acc = 0;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, W, H);
      ctx.globalCompositeOperation = dark ? 'lighter' : 'source-over';
      ctx.globalAlpha = (leaving ? Math.max(0, 1 - (now - leaving) / 650) : 1) * (dark ? 0.95 : 1);
      for (const p of parts) {
        ctx.fillStyle = p.c;
        const s = p.s * (1 + p.t * 0.6);
        ctx.fillRect(p.x - s / 2, p.y - s / 2, s, s);
      }
      if (leaving && now - leaving > 800) finish();
    }

    function enter() {
      if (leaving) return;
      leaving = performance.now();
      try { sessionStorage.setItem('intro', '1'); } catch {}
      // 粒子从名字中心炸开
      for (const p of parts) {
        const dx = p.x - W / 2, dy = p.y - H / 2, d = Math.hypot(dx, dy) || 1, v = 9 + Math.random() * 20;
        p.vx += (dx / d) * v + (Math.random() - 0.5) * 6;
        p.vy += (dy / d) * v + (Math.random() - 0.5) * 6;
      }
      // 把炸开的粒子交给首页的光带:它们从同样的位置、带着同样的速度出发,再汇进光带
      const data = new Float32Array(parts.length * 4);
      parts.forEach((p, i) => { data[i * 4] = p.x; data[i * 4 + 1] = p.y; data[i * 4 + 2] = p.vx; data[i * 4 + 3] = p.vy; });
      dispatchEvent(new CustomEvent('intro:burst', { detail: { n: parts.length, data } }));
      root.classList.add('leaving');
      // 主页露出来的同时,开始播大标题的入场动画
      document.documentElement.classList.remove('intro-on');
      root.style.display = 'block';
    }
    function finish() {
      cancelAnimationFrame(raf);
      removeEventListener('resize', build);
      removeEventListener('keydown', key);
      root.remove();
    }
    const key = (e: KeyboardEvent) => { if (e.key === 'Enter' || e.key === ' ' || e.key === 'Escape') { e.preventDefault(); enter(); } };

    root.addEventListener('pointermove', move);
    root.addEventListener('pointerleave', out);
    let down = { x: 0, y: 0 };
    root.addEventListener('pointerdown', (e) => { down = { x: e.clientX, y: e.clientY }; });
    root.addEventListener('pointerup', (e) => {
      // 只有点在名字上才进入;滑动吹粒子后松手不算点击
      const tap = Math.hypot(e.clientX - down.x, e.clientY - down.y) < 12;
      if (tap && e.clientX > box.x0 && e.clientX < box.x1 && e.clientY > box.y0 && e.clientY < box.y1) enter();
      if (e.pointerType === 'touch') out();
    });
    addEventListener('keydown', key);
    addEventListener('resize', build);
    build();
    document.fonts?.ready.then(() => { if (!leaving) build(); });
    raf = requestAnimationFrame(frame);
  }

  const init = () => {
    const root = document.getElementById('intro');
    if (root && document.documentElement.classList.contains('intro-on')) start(root);
  };
  document.addEventListener('astro:page-load', init);
  init();
</script>
