---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
import Intro from '../components/Intro.astro';
import { SITE } from '../config';
interface Props { title?: string; description?: string; banner?: 'full' | 'slim'; bannerTitle?: string; bannerSub?: string; vt?: string; }
const { title, description = SITE.description, banner = 'slim', bannerTitle, bannerSub, vt } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.title}` : SITE.title;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        function apply() {
          root.classList.add('js');
          try {
            var t = localStorage.getItem('theme');
            var dark = t ? t === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
            root.classList.toggle('dark', dark);
          } catch (e) {}
          // 配色跟着访问时间走;加 ?time=dawn|day|dusk|night 可以预览
          var q = new URLSearchParams(location.search).get('time');
          var h = new Date().getHours();
          root.dataset.time = /^(dawn|day|dusk|night)$/.test(q || '') ? q : h >= 5 && h < 9 ? 'dawn' : h >= 9 && h < 17 ? 'day' : h >= 17 && h < 20 ? 'dusk' : 'night';
        }
        apply();
        document.addEventListener('astro:after-swap', apply);
        // 入场动画:每次打开浏览器只出现一次,而且只在从首页进站时出现;加 ?intro=1 可以重看
        try {
          var force = new URLSearchParams(location.search).get('intro') === '1';
          var calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (location.pathname === '/' && !calm && (force || !sessionStorage.getItem('intro'))) root.classList.add('intro-on');
          else sessionStorage.setItem('intro', '1');
        } catch (e) {}
      })();
    </script>
    <ClientRouter />
  </head>
  <body class="flex min-h-screen flex-col">
    <div class="blobs" transition:persist="blobs" aria-hidden="true">
      <div class="blob blob-a" style="width:34rem;height:34rem;left:-10rem;top:6%"></div>
      <div class="blob blob-b" style="width:30rem;height:30rem;right:-8rem;top:45%"></div>
      <div class="blob blob-c" style="width:26rem;height:26rem;left:38%;top:68%"></div>
    </div>
    <div id="read-progress" aria-hidden="true"></div>
    {Astro.url.pathname === '/' && <Intro />}
    <Header />
    <Banner size={banner} title={bannerTitle} sub={bannerSub} vt={vt} />
    <main class="flex-1"><slot /></main>
    <Footer />
    <button id="to-top" type="button" class="glass" aria-label="回到顶部">
      <svg class="top-ring" viewBox="0 0 46 46" aria-hidden="true"><defs><linearGradient id="to-top-grad"><stop offset="0" stop-color="var(--violet)"/><stop offset="1" stop-color="var(--cyan)"/></linearGradient></defs><circle cx="23" cy="23" r="20"/></svg>
      <svg class="arrow h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
    </button>
    <script>import '../scripts/fx';</script>
  </body>
</html>
