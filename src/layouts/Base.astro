---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
import { SITE } from '../config';
interface Props { title?: string; description?: string; banner?: 'full' | 'slim'; bannerTitle?: string; bannerSub?: string; vt?: string; }
const { title, description = SITE.description, banner = 'slim', bannerTitle, bannerSub, vt } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.title}` : SITE.title;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        function apply() {
          root.classList.add('js');
          try {
            var t = localStorage.getItem('theme');
            var dark = t ? t === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
            root.classList.toggle('dark', dark);
          } catch (e) {}
        }
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <ClientRouter />
  </head>
  <body class="flex min-h-screen flex-col">
    <div class="blobs" transition:persist="blobs" aria-hidden="true">
      <div class="blob blob-a" style="width:34rem;height:34rem;left:-10rem;top:6%;background:var(--violet)"></div>
      <div class="blob blob-b" style="width:30rem;height:30rem;right:-8rem;top:45%;background:var(--cyan)"></div>
      <div class="blob blob-c" style="width:26rem;height:26rem;left:38%;top:68%;background:linear-gradient(135deg,var(--violet),var(--cyan))"></div>
    </div>
    <div id="read-progress" aria-hidden="true"></div>
    <Header />
    <Banner size={banner} title={bannerTitle} sub={bannerSub} vt={vt} />
    <main class="flex-1"><slot /></main>
    <Footer />
    <button id="to-top" type="button" class="glass" aria-label="回到顶部">
      <svg class="ring" viewBox="0 0 46 46" aria-hidden="true"><defs><linearGradient id="to-top-grad"><stop offset="0" stop-color="var(--violet)"/><stop offset="1" stop-color="var(--cyan)"/></linearGradient></defs><circle cx="23" cy="23" r="20"/></svg>
      <svg class="arrow h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
    </button>
    <script>import '../scripts/fx';</script>
  </body>
</html>
