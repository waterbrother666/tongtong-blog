---
import { getCollection } from 'astro:content';
import Shell from '../../layouts/Shell.astro';
const posts = await getCollection('posts', (p) => !p.data.draft);
const counts = new Map<string, number>();
posts.forEach((p) => p.data.tags.forEach((t) => counts.set(t, (counts.get(t) ?? 0) + 1)));
---
<Shell title="标签" bannerTitle="标签" bannerSub={`共 ${counts.size} 个`}>
  <div class="reveal"><div class="glass flex flex-wrap gap-3 p-6 md:p-8">
    {[...counts].sort().map(([t, n], i) => <a href={`/tags/${t}`} class:list={['chip px-4 py-2 text-sm', i % 2 && 'chip-cyan']}>#{t} <span class="ml-1 opacity-60">{n}</span></a>)}
  </div></div>
</Shell>
